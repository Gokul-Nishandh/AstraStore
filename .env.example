# AstraStore — deployment configuration
#
# Copy to `.env` beside docker-compose.yaml and fill in real values.
# `.env` must never be committed.

# ---------------------------------------------------------------------------
# Internal service token  (REQUIRED IN PRODUCTION)
# ---------------------------------------------------------------------------
# Shared secret that metadata, upload, download and replication present to each
# other on the /internal/** surface. That surface bypasses every per-user
# ownership check, so anything able to reach it can read and modify any user's
# object metadata.
#
# metadata, upload, download and replication must all be given the SAME value.
#
# The services refuse to start when this is unset outside a development
# profile — a misconfigured deployment fails loudly rather than quietly
# serving internal endpoints to anyone who can reach the container network.
#
# docker-compose falls back to `dev-only-not-for-production` so a local stack
# comes up without setup. That fallback is not a secret and must never reach a
# real deployment. Generate one with:
#
#     openssl rand -base64 32
#
ASTRA_INTERNAL_TOKEN=

# ---------------------------------------------------------------------------
# JWT signing
# ---------------------------------------------------------------------------
# Secret the auth service signs access tokens with. Rotating it invalidates
# every issued token, signing all users out.
JWT_SECRET=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_USER=astrastore
POSTGRES_PASSWORD=
POSTGRES_DB=astrastore

# ---------------------------------------------------------------------------
# Dashboard
# ---------------------------------------------------------------------------
# Origins the API gateway will accept browser requests from. Comma separated.
# Wildcards are deliberately not supported: a credentialed request cannot use
# one, and a public deployment should name its own origin.
ASTRA_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
